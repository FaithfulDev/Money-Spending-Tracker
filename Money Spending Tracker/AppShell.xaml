<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Money_Spending_Tracker.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Money_Spending_Tracker"
    Title="Money_Spending_Tracker">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:Features.Home.HomePage}"
        Route="Home">
        <ShellContent.FlyoutIcon>
            <FontImageSource
                FontFamily="FontAwesomeSolid"
                Glyph="&#xf015;"
                Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"/>
        </ShellContent.FlyoutIcon>
    </ShellContent>

</Shell>
