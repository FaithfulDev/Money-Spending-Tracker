<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Money_Spending_Tracker.Features.Accounts"
             x:Class="Money_Spending_Tracker.Features.Accounts.AccountsPage"
             x:DataType="local:AccountsViewModel" 
             Title="Accounts" x:Name="RootView">

    <Grid>

        <VerticalStackLayout>

            <Border Margin="10,0,10,0" Padding="15" BackgroundColor="red" IsVisible="{Binding DidTimeoutOccur}">
                <Label Text="One or more request timed out." HorizontalOptions="Center" TextColor="White" />
            </Border>

            <CollectionView ItemsSource="{Binding Accounts}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:AccountModel">
                        <Border Margin="10,10,10,0">
                            <Grid Padding="10" ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">
                                <StackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding AccountName}" FontAttributes="Bold" />
                                    <Label Text="{Binding AccountIban}" FontAttributes="Italic" FontSize="12" />
                                    <HorizontalStackLayout>
                                        <Label Text="Expires in approximately: " FontSize="12"/>
                                        <Label Text="{Binding ExpiresInApproximatelyDays}" FontSize="12"/>
                                        <Label Text=" days" FontSize="12"/>
                                    </HorizontalStackLayout>
                                </StackLayout>

                                <HorizontalStackLayout Grid.Column="1">

                                    <ImageButton
                                        HeightRequest="28"
                                        WidthRequest="28"
                                        Padding="9"
                                        Margin="0,0,10,0"
                                        Command="{Binding ReAuthenticateCommand}">
                                        <ImageButton.Source>
                                            <FontImageSource
                                                FontFamily="FontAwesomeSolid"
                                                Glyph="&#xf021;"
                                                Color="Black"/>
                                        </ImageButton.Source>
                                    </ImageButton>

                                    <ImageButton
                                        HeightRequest="28"
                                        WidthRequest="28"
                                        BackgroundColor="Red"
                                        Padding="9"
                                        Command="{Binding DeleteCommand}">
                                        <ImageButton.Source>
                                            <FontImageSource
                                                FontFamily="FontAwesomeSolid"
                                                Glyph="&#xf2ed;"
                                                Color="White"/>
                                        </ImageButton.Source>
                                    </ImageButton>
                                    
                                </HorizontalStackLayout>

                                <Label IsVisible="{Binding IsExpired}" 
                                       Text="Account has expired - re-authenticate now!"
                                       TextColor="Red" Margin="0,10,0,0"
                                       Grid.Row="1" Grid.ColumnSpan="2"/>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Add Account" Command="{Binding AddAccountCommand}" Margin="10,20" />

        </VerticalStackLayout>

        <Grid x:Name="Overlay" IsVisible="{Binding IsWorking}">
            <BoxView BackgroundColor="Gray" Opacity="0.7"/>
            <Border
                IsVisible="True"
                HorizontalOptions="Center" 
                VerticalOptions="Center"
                BackgroundColor="White"
                WidthRequest="300" HeightRequest="100"
                Margin="0,-100,0,0">
                <Border.Shadow>
                    <Shadow
                        Offset="5,5"
                        Radius="3"
                        Brush="Black"
                        Opacity="0.3" />
                </Border.Shadow>
                <Grid ColumnDefinitions="auto,*">
                    <ActivityIndicator Grid.Column="0" 
                        Margin="20"
                        x:Name="ActivityIndicator" 
                        IsVisible="True" 
                        IsRunning="True"/>

                    <VerticalStackLayout VerticalOptions="Center" Grid.Column="1">
                        <Label Text="Updating Data"
                            FontSize="16" FontAttributes="Bold"/>
                        <Label Text="{Binding AccountBeingUpdated, TargetNullValue='Fetching Accounts'}"
                            FontSize="14"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </Grid>

    </Grid>

</ContentPage>