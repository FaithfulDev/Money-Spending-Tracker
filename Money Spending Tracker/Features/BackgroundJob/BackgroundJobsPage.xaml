<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Money_Spending_Tracker.Features.BackgroundJob"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Money_Spending_Tracker.Features.BackgroundJob.BackgroundJobsPage"
             x:DataType="local:BackgroundJobsViewModel" 
             Title="Background Jobs">

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:IsNotNullConverter x:Key="IsNotNullConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <Grid>
        <CollectionView ItemsSource="{Binding Jobs}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:BackgroundJobModel">
                    <Border Margin="10,10,10,0">
                        <Grid Padding="10" ColumnDefinitions="*,*" RowDefinitions="*,Auto">

                            <StackLayout Grid.Column="0" Spacing="2">
                                <HorizontalStackLayout IsVisible="{Binding Scheduled, Converter={StaticResource IsNotNullConverter}}">
                                    <Label Text="Scheduled: "/>
                                    <Label Text="{Binding Scheduled}" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout IsVisible="{Binding StartedAt, Converter={StaticResource IsNotNullConverter}}">
                                    <Label Text="Started: "/>
                                    <Label Text="{Binding StartedAt}" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout IsVisible="{Binding FinishedAt, Converter={StaticResource IsNotNullConverter}}">
                                    <Label Text="Finished: "/>
                                    <Label Text="{Binding FinishedAt}"/>
                                </HorizontalStackLayout>
                            </StackLayout>

                            <Label Grid.Column="1" Text="{Binding State}" HorizontalOptions="End"/>

                            <Label IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}" 
                                   Text="{Binding ErrorMessage}"
                                   TextColor="Red" Margin="0,10,0,0"
                                   Grid.Row="1" Grid.ColumnSpan="2"/>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
    
</ContentPage>