<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Money_Spending_Tracker.Features.Home"
             xmlns:monthSummery="clr-namespace:Money_Spending_Tracker.Features.MonthSummary"
             x:Class="Money_Spending_Tracker.Features.Home.HomePage"
             x:DataType="local:HomeViewModel"
             Title="{Binding Title}">
    <Grid>
        <Grid RowDefinitions="auto, *">

            <VerticalStackLayout Grid.Row="0">
                
                <Border Margin="15,0,15,0" Padding="15" BackgroundColor="Red" IsVisible="{Binding DidTimeout}">
                    <Label Text="One or more request timed out. Try again." HorizontalOptions="Center" TextColor="White" />
                </Border>

                <Border Margin="15,0,15,0" Padding="15" BackgroundColor="#FCFCBF" IsVisible="{Binding ShowExpireWarning}">
                    <VerticalStackLayout>
                        
                        <Label IsVisible="{Binding ShowExpiresInDaysWarning}" HorizontalOptions="Center" TextColor="Black"
                            Text="{Binding DaysUntilExpiry, StringFormat='One (or more) of your accounts will expire in {0} days.\
You can re-authenticate beforehand if you like.'}" />

                        <Label IsVisible="{Binding ShowExpireSoonWarning}" HorizontalOptions="Center" TextColor="Black"
                            Text="One or more of your accounts will expire soon. You should re-authenticate them as soon as possible." />

                        <Label IsVisible="{Binding ShowAlreadyExpiredWarning}" HorizontalOptions="Center" TextColor="Black"
                            Text="One or more of your accounts has expired. Please re-authenticate now." />

                        <HorizontalStackLayout>
                            <Label Text="Check Accounts" TextColor="Blue" Margin="0,5,0,0" VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CheckAccountsCommand}" />
                                </Label.GestureRecognizers>
                            </Label>

                            <Label Text=" &#xf061;" TextColor="Blue" Margin="0,5,0,0" VerticalTextAlignment="Center" FontFamily="FontAwesomeSolid" />
                        </HorizontalStackLayout>
                        
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
            

            <RefreshView Grid.Row="1"
                IsRefreshing="{Binding PullToRefreshIndicatorVisible}"
                Command="{Binding RefreshCommand}">

                <ScrollView>
                    <monthSummery:MonthSummaryView Balance="{Binding Balance}" RemainingBudget="{Binding RemainingBudget}" />
                </ScrollView>

            </RefreshView>
        </Grid>

        <Grid x:Name="Overlay" IsVisible="{Binding IsWorking}">
            <BoxView BackgroundColor="Gray" Opacity="0.7"/>
            <Border
                IsVisible="True"
                HorizontalOptions="Center" 
                VerticalOptions="Center"
                BackgroundColor="White"
                WidthRequest="300" HeightRequest="100"
                Margin="0,-100,0,0">
                <Border.Shadow>
                    <Shadow
                        Offset="5,5"
                        Radius="3"
                        Brush="Black"
                        Opacity="0.3" />
                </Border.Shadow>
                <Grid ColumnDefinitions="auto,*">
                    <ActivityIndicator Grid.Column="0" 
                        Margin="20"
                        x:Name="ActivityIndicator" 
                        IsVisible="True" 
                        IsRunning="True"/>

                    <VerticalStackLayout VerticalOptions="Center" Grid.Column="1">
                        <Label Text="Updating Data"
                               FontSize="16" FontAttributes="Bold"/>
                        <Label Text="{Binding AccountBeingUpdated, TargetNullValue='Fetching Accounts'}"
                               FontSize="14"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </Grid>

    </Grid>
    

</ContentPage>
