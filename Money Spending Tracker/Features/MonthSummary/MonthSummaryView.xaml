<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Money_Spending_Tracker.Features.MonthSummary"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Money_Spending_Tracker.Features.MonthSummary.MonthSummaryView"
             x:Name="this">

    <ContentView.Resources>
        <ResourceDictionary>
            <toolkit:IsNotNullConverter x:Key="IsNotNullConverter" />
        </ResourceDictionary>
    </ContentView.Resources>

    <VerticalStackLayout Padding="15">

        <Border HorizontalOptions="Fill" Padding="20" Margin="0,0,0,20" 
                IsVisible="{Binding RemainingBudget, Source={x:Reference this}, Converter={StaticResource IsNotNullConverter}}">
            <VerticalStackLayout HorizontalOptions="Fill">
                <Label Text="Remaining Budget" Margin="2" FontAttributes="Bold" FontSize="20" />
                <Label Text="{Binding RemainingBudget, Source={x:Reference this}, StringFormat='{0:C}'}" 
                       TextColor="{Binding RemainingBudgetColor, Source={x:Reference this}, x:DataType=local:MonthSummaryView}"
                       FontSize="28"/>
            </VerticalStackLayout>
        </Border>

        <Border HorizontalOptions="Fill" Padding="20" Margin="0">
            <VerticalStackLayout HorizontalOptions="Fill">
                <Label Text="Overall Balance" Margin="2" FontAttributes="Bold" FontSize="20" />
                <Label Text="{Binding Balance, Source={x:Reference this}, StringFormat='{0:C}'}" 
                       TextColor="{Binding BalanceColor, Source={x:Reference this}, x:DataType=local:MonthSummaryView}"
                       FontSize="28"/>
            </VerticalStackLayout>
        </Border>

    </VerticalStackLayout>
    
</ContentView>
