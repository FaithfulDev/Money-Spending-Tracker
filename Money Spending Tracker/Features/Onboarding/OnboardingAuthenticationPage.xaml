<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Money_Spending_Tracker.Features.Onboarding"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Money_Spending_Tracker.Features.Onboarding.OnboardingAuthenticationPage"
             x:DataType="local:OnboardingAuthenticationViewModel"
             Title="Account Authentication" x:Name="Page">

    <Grid Margin="18,0" RowDefinitions="Auto,*,*,Auto,40">

        <VerticalStackLayout Grid.Row="0">

            <Label Text="Name of banking institution" FontAttributes="Bold" Margin="2,0"/>
            <Entry Placeholder="Name of banking institution" 
                   Margin="0" x:Name="InstituionEntry"
                   Text="{Binding InstitutionName}">
                <Entry.Behaviors>
                    <toolkit:EventToCommandBehavior
                        EventName="TextChanged"
                        BindingContext="{Binding Path=BindingContext, Source={x:Reference InstituionEntry}, x:DataType=Entry}"
                        Command="{Binding Source={x:Reference Page}, Path=BindingContext.InstitutionNameChangedCommand, x:DataType=ContentPage}" />
                </Entry.Behaviors>
            </Entry>

        </VerticalStackLayout>

        <ListView Grid.Row="1" ItemsSource="{Binding FilteredInstitutions}"
                   ItemSelected="ListView_ItemSelected" SelectionMode="Single"/>

        <ActivityIndicator 
            Grid.Row="2"
            WidthRequest="200"
            HeightRequest="150"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            IsVisible="{Binding IsWorking}" 
            IsRunning="{Binding IsWorking}"/>

        <Button 
            Grid.Row="3"
            Text="Authenticate" 
            Margin="10,20" 
            Command="{Binding AuthenticateCommand}" />

    </Grid>
    
</ContentPage>