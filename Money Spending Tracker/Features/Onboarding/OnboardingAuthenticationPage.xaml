<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Money_Spending_Tracker.Features.Onboarding.OnboardingAuthenticationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Money_Spending_Tracker.Features.Onboarding"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="Page"
    Title="Account Authentication"
    x:DataType="local:OnboardingAuthenticationViewModel">

    <Grid Margin="18,0" RowDefinitions="Auto,*,Auto,40">

        <VerticalStackLayout Grid.Row="0">

            <Label
                Margin="2,0"
                FontAttributes="Bold"
                Text="Name of banking institution" />
            <Entry
                x:Name="InstituionEntry"
                Margin="0"
                Placeholder="Name of banking institution"
                Text="{Binding InstitutionName}">
                <Entry.Behaviors>
                    <toolkit:EventToCommandBehavior
                        BindingContext="{Binding Path=BindingContext, Source={x:Reference InstituionEntry}, x:DataType=Entry}"
                        Command="{Binding Source={x:Reference Page}, Path=BindingContext.InstitutionNameChangedCommand, x:DataType=ContentPage}"
                        EventName="TextChanged" />
                </Entry.Behaviors>
            </Entry>

        </VerticalStackLayout>

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding FilteredInstitutions}"
            SelectedItem="{Binding SelectedItem}"
            SelectionChangedCommand="{Binding SelectionChangedCommand}"
            SelectionMode="Single">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:InstitutionModel">
                    <Label
                        Margin="5,10"
                        Text="{Binding Name}"
                        VerticalOptions="Center" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator
            Grid.Row="1"
            HeightRequest="150"
            HorizontalOptions="Center"
            IsRunning="{Binding IsWorking}"
            IsVisible="{Binding IsWorking}"
            VerticalOptions="Center"
            WidthRequest="200" />

        <Button
            Grid.Row="2"
            Margin="10,20"
            Command="{Binding AuthenticateCommand}"
            Text="Authenticate" />

    </Grid>

</ContentPage>