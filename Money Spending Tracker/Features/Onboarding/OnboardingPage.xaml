<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Money_Spending_Tracker.Features.Onboarding.OnboardingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Onboarding">
    <Grid Margin="18,0" RowDefinitions="Auto,Auto,*,Auto,40">
        <Label
            Grid.Row="0"
            Margin="0,10"
            FontSize="Body"
            HorizontalOptions="Start"
            VerticalOptions="Center">
            <Label.Text>
                Welcome to the Money Spending Tacker!
            </Label.Text>
        </Label>

        <Label
            Grid.Row="1"
            FontSize="Body"
            HorizontalOptions="Start"
            VerticalOptions="Center">
            <Label.Text>
                We need to setup a few things before you can start using the app.
            </Label.Text>
        </Label>

        <Button
            Grid.Row="3"
            Clicked="Button_Clicked"
            Text="Begin Setup" />
    </Grid>
</ContentPage>