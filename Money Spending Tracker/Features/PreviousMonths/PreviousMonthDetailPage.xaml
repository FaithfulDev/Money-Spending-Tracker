<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Money_Spending_Tracker.Features.PreviousMonths.PreviousMonthDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Money_Spending_Tracker.Features.PreviousMonths"
    xmlns:monthSummery="clr-namespace:Money_Spending_Tracker.Features.MonthSummary"
    Title="{Binding Title}"
    x:DataType="local:PreviousMonthDetailViewModel">

    <VerticalStackLayout>
        <monthSummery:MonthSummaryView
            Balance="{Binding Balance}"
            MonthYear="{Binding MonthYear}"
            TagBalances="{Binding TagBalances}" />
    </VerticalStackLayout>

</ContentPage>