<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Money_Spending_Tracker.Features.PreviousMonths.PreviousMonthListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Money_Spending_Tracker.Features.PreviousMonths"
    Title="Previous Months"
    x:DataType="local:PreviousMonthListViewModel">
    <Grid Margin="18,-10,18,15" RowDefinitions="*,Auto">
        <CollectionView
            IsGrouped="True"
            ItemSizingStrategy="MeasureFirstItem"
            ItemsSource="{Binding Items}"
            RemainingItemsThreshold="5"
            RemainingItemsThresholdReachedCommand="{Binding LoadMoreItemsCommand}"
            SelectedItem="{Binding SelectedItem}"
            SelectionChangedCommand="{Binding SelectionChangedCommand}"
            SelectionMode="Single">
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="local:PreviousMonthGroup">
                    <Border
                        Margin="0,10,0,0"
                        Padding="0,0,0,0"
                        BackgroundColor="#e6e6e6"
                        Stroke="Transparent">
                        <Border.Shadow>
                            <Shadow
                                Brush="Black"
                                Opacity="0.3"
                                Radius="12"
                                Offset="0,4" />
                        </Border.Shadow>
                        <Label
                            Padding="10"
                            FontAttributes="Bold"
                            FontSize="20"
                            Text="{Binding Year}" />
                    </Border>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:PreviousMonthListModel">
                    <Border
                        Margin="0,0,0,0"
                        BackgroundColor="#f2f2f2"
                        Stroke="Transparent">
                        <Grid Padding="10" ColumnDefinitions="Auto,*">
                            <Label Grid.Column="0" Text="{Binding MonthYear, StringFormat='{0:MMMM yyyy}'}" />
                            <Label
                                Grid.Column="1"
                                HorizontalTextAlignment="End"
                                Text="{Binding Balance, StringFormat='{0:C}'}"
                                TextColor="{Binding BalanceColor}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator
            Grid.Row="1"
            IsRunning="{Binding IsLoadingMoreItems}"
            IsVisible="{Binding IsLoadingMoreItems}" />
    </Grid>
</ContentPage>