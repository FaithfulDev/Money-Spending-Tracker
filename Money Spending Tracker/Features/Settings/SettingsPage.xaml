<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Money_Spending_Tracker.Features.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Money_Spending_Tracker.Features.Settings"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Title="Settings"
    x:DataType="local:SettingsViewModel">

    <Grid Margin="18,0">

        <ScrollView Grid.Row="0">

            <VerticalStackLayout Grid.Row="0">

                <Label
                    Margin="2,0"
                    FontAttributes="Bold"
                    Text="Monthly Budget" />
                <Entry
                    Margin="0"
                    Keyboard="Numeric"
                    Placeholder="Monthly Budget"
                    Text="{Binding MonthlyBudget}" />

                <Button
                    Grid.Row="3"
                    Margin="10,10"
                    Command="{Binding SaveCommand}"
                    Text="Save" />

                <Label
                    Margin="2,20,0,0"
                    FontAttributes="Bold"
                    Text="Automatic Updates" />

                <Label Margin="2,10,0,0">
                    <Label.Text>
                        App tries to automatically update accounts every 24 hours.
                    </Label.Text>
                </Label>

                <HorizontalStackLayout>
                    <Label
                        Margin="0,5,0,0"
                        Text="Check Jobs"
                        TextColor="Blue"
                        VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CheckJobsCommand}" />
                        </Label.GestureRecognizers>
                    </Label>

                    <Label
                        Margin="0,5,0,0"
                        FontFamily="FontAwesomeSolid"
                        Text=" &#xf061;"
                        TextColor="Blue"
                        VerticalTextAlignment="Center" />
                </HorizontalStackLayout>

                <Label
                    Margin="2,20,0,0"
                    FontAttributes="Bold"
                    Text="Update API Credentials" />

                <Button
                    Grid.Row="3"
                    Margin="10,10"
                    Command="{Binding UpdateApiCredentialsCommand}"
                    Text="Update API Credentials" />


                <Label
                    Margin="2,20,0,0"
                    FontAttributes="Bold"
                    Text="Delete Transactions" />
                <Label Margin="2,10,0,0">
                    <Label.Text>
                        Delete all transactions, from all accounts, but keep everything else.
                    </Label.Text>
                </Label>

                <Button
                    Grid.Row="3"
                    Margin="10,10"
                    Command="{Binding DeleteTransactionsCommand}"
                    Text="Delete Transactions" />

                <Label
                    Margin="2,20,0,0"
                    FontAttributes="Bold"
                    Text="Delete ALL Data" />
                <Label Margin="2,10,0,0">
                    <Label.Text>
                        Delete everything. App will restart with onboarding.
                    </Label.Text>
                </Label>

                <Button
                    Grid.Row="3"
                    Margin="10,10"
                    BackgroundColor="#C61E1E"
                    Command="{Binding DeleteAllDataCommand}"
                    Text="Delete ALL Data"
                    TextColor="White" />

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>