<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Money_Spending_Tracker.Features.Start.StartPage"
             Title="Start">
    <VerticalStackLayout Padding="15">
        
        <Label Text="Database Password" Margin="2" FontAttributes="Bold" />
        
        <Entry x:Name="PasswordEntry"
               Placeholder="Enter database password"
               IsPassword="True"/>

        <Button Text="Unlock" Margin="10,20" Clicked="Button_Clicked" />

        <ActivityIndicator x:Name="ActivityIndicator" IsVisible="True" IsRunning="True"/>

    </VerticalStackLayout>
</ContentPage>