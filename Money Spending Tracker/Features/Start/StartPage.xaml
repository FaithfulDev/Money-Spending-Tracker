<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Money_Spending_Tracker.Features.Start"
             x:Class="Money_Spending_Tracker.Features.Start.StartPage"
             x:DataType="local:StartViewModel"
             Title="Start">
    <VerticalStackLayout Padding="15">
        
        <Label Text="Database Password" Margin="2" FontAttributes="Bold" />
        
        <Entry x:Name="PasswordEntry"
               Placeholder="Enter database password"
               IsPassword="True"
               Text="{Binding Password}"/>

        <Button Text="Unlock" Margin="10,20" Command="{Binding UnlockCommand}" />
        <Button Text="Unlock with biometric" Margin="10,0" Command="{Binding UnlockWithBiometricCommand}" />

        <ActivityIndicator 
            x:Name="ActivityIndicator" 
            IsVisible="{Binding IsWorking}" 
            IsRunning="{Binding IsWorking}"/>

    </VerticalStackLayout>
</ContentPage>