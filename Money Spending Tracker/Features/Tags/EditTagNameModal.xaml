<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Money_Spending_Tracker.Features.Tags.EditTagNameModal"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Money_Spending_Tracker.Features.Tags"
    Title="EditTagNameModal"
    x:DataType="local:EditTagNameViewModel"
    BackgroundColor="Transparent"
    Shell.PresentationMode="ModalNotAnimated">

    <Grid>
        <BoxView BackgroundColor="Gray" Opacity="0.7">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CancelCommand}" />
            </BoxView.GestureRecognizers>
        </BoxView>
        <Border
            Margin="20,-100,20,0"
            Padding="10"
            BackgroundColor="White"
            HorizontalOptions="Fill"
            InputTransparent="False"
            IsVisible="True"
            VerticalOptions="Center">
            <Border.Shadow>
                <Shadow
                    Brush="Black"
                    Opacity="0.3"
                    Radius="3"
                    Offset="5,5" />
            </Border.Shadow>
            <Grid>

                <VerticalStackLayout VerticalOptions="Center">
                    <Label
                        Margin="2"
                        FontAttributes="Bold"
                        Text="Tag Name" />

                    <Entry Placeholder="New Tag Name" Text="{Binding Name}" />

                    <Button
                        Margin="0,10,0,0"
                        Command="{Binding SaveCommand}"
                        Text="Save" />

                </VerticalStackLayout>

            </Grid>
        </Border>
    </Grid>

</ContentPage>