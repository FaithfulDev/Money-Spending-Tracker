<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Money_Spending_Tracker.Features.Transactions.TransactionsFilterPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dataModels="clr-namespace:Money_Spending_Tracker.Data;assembly=MoneySpendingTracker.Data"
    xmlns:local="clr-namespace:Money_Spending_Tracker.Features.Transactions"
    x:DataType="local:TransactionsFilterViewModel">

    <VerticalStackLayout>

        <Label
            Margin="2,0"
            FontAttributes="Bold"
            Text="Date Begin" />

        <DatePicker Date="{Binding DateBegin}" />

        <Label
            Margin="2,10,0,0"
            FontAttributes="Bold"
            Text="Date End" />

        <DatePicker Date="{Binding DateEnd}" />

        <Label
            Margin="2,10,0,0"
            FontAttributes="Bold"
            Text="Tag" />

        <Picker
            ItemDisplayBinding="{Binding Name}"
            ItemsSource="{Binding Tags}"
            SelectedItem="{Binding SelectedTag}" />

        <Label
            Margin="2,10,0,0"
            FontAttributes="Bold"
            Text="Account" />

        <Picker
            ItemDisplayBinding="{Binding AccountName}"
            ItemsSource="{Binding Accounts}"
            SelectedItem="{Binding SelectedAccount}" />

        <Button
            Margin="0,20,0,0"
            Command="{Binding ApplyFiltersCommand}"
            Text="Apply Filters" />

    </VerticalStackLayout>

</ContentView>
